  71          static uint32_t ADC_ReadFilteredCurrentX10Ma(uint8_t channel)
  72          {
  73   1          uint8_t sample;
  74   1          uint16_t adc_value;
  75   1          uint16_t min_value1 = 0xFFFFU;
  76   1          uint16_t min_value2 = 0xFFFFU;
  77   1          uint16_t max_value1 = 0U;
  78   1          uint16_t max_value2 = 0U;
  79   1          uint32_t adc_sum = 0UL;
  80   1      
  81   1          ADC_ConfigChannel(channel, ADC_DIV_4);
  82   1          for(sample = 0U; sample < ADC_SAMPLE_COUNT; sample++)
  83   1          {
  84   2              ADC_StartSWCVT();
  85   2              adc_value = ADC_GetResultQueryMode();
  86   2              adc_sum += adc_value;
  87   2      
  88   2                 if(adc_value < min_value1)
  89   2              {
  90   3                  min_value2 = min_value1;
  91   3                  min_value1 = adc_value;
  92   3              }
  93   2              else if(adc_value < min_value2)
  94   2              {
  95   3                  min_value2 = adc_value;
  96   3              }
  97   2      
  98   2              if(adc_value > max_value1)
  99   2              {
 100   3                  max_value2 = max_value1;
 101   3                  max_value1 = adc_value;
 102   3              }
 103   2              else if(adc_value > max_value2)
 104   2              {
 105   3                  max_value2 = adc_value;
 106   3              }
 107   2          }
 108   1      
 109   1          adc_sum -= (uint32_t)min_value1 + min_value2 + max_value1 + max_value2;
 110   1      
 111   1          return (adc_sum * ADC_REFERENCE_MV * CURRENT_FIXED_POINT_SCALE) /
 112   1                 CURRENT_CONVERSION_DIVISOR;
 113   1      }
