  69          static uint32_t ADC_ReadFilteredCurrentX10Ma(uint8_t channel)
  70          {
  71   1          uint8_t sample;
  72   1          uint16_t adc_value;
  73   1          uint16_t min_value1 = 0xFFFFU;
  74   1          uint16_t min_value2 = 0xFFFFU;
  75   1          uint16_t max_value1 = 0U;
  76   1          uint16_t max_value2 = 0U;
  77   1          uint32_t adc_sum = 0UL;
  78   1      
  79   1          ADC_ConfigChannel(channel, ADC_DIV_4);
  80   1          for(sample = 0U; sample < ADC_SAMPLE_COUNT; sample++)
  81   1          {
  82   2              ADC_StartSWCVT();
  83   2              adc_value = ADC_GetResultQueryMode();
  84   2              adc_sum += adc_value;
  85   2      
  86   2              if(adc_value < min_value1)
  87   2              {
  88   3                  min_value2 = min_value1;
  89   3                  min_value1 = adc_value;
  90   3              }
  91   2              else if(adc_value < min_value2)
  92   2              {
  93   3                  min_value2 = adc_value;
  94   3              }
  95   2      
  96   2              if(adc_value > max_value1)
  97   2              {
  98   3                  max_value2 = max_value1;
  99   3                  max_value1 = adc_value;
 100   3              }
 101   2              else if(adc_value > max_value2)
 102   2              {
 103   3                  max_value2 = adc_value;
 104   3              }
 105   2          }
 106   1      
 107   1          adc_sum -= (uint32_t)min_value1 + min_value2 + max_value1 + max_value2;
 108   1      
 109   1          return (adc_sum * ADC_REFERENCE_MV * CURRENT_FIXED_POINT_SCALE) /
 110   1                 CURRENT_CONVERSION_DIVISOR;
 111   1      }
