  67          static uint32_t ADC_ReadFilteredCurrentX10Ma(uint8_t channel)
  68          {
  69   1          uint8_t sample;
  70   1          uint16_t adc_value;
  71   1          uint16_t min_value1 = 0xFFFFU;
  72   1          uint16_t min_value2 = 0xFFFFU;
  73   1          uint16_t max_value1 = 0U;
  74   1          uint16_t max_value2 = 0U;
  75   1          uint32_t adc_sum = 0UL;
  76   1      
  77   1          ADC_ConfigChannel(channel, ADC_DIV_4);
  78   1          for(sample = 0U; sample < ADC_SAMPLE_COUNT; sample++)
  79   1          {
  80   2              ADC_StartSWCVT();
  81   2              adc_value = ADC_GetResultQueryMode();
  82   2              adc_sum += adc_value;
  83   2      
  84   2              if(adc_value < min_value1)
  85   2              {
  86   3                  min_value2 = min_value1;
  87   3                  min_value1 = adc_value;
  88   3              }
  89   2              else if(adc_value < min_value2)
  90   2              {
  91   3                  min_value2 = adc_value;
  92   3              }
  93   2      
  94   2              if(adc_value > max_value1)
  95   2              {
  96   3                  max_value2 = max_value1;
  97   3                  max_value1 = adc_value;
  98   3              }
  99   2              else if(adc_value > max_value2)
 100   2              {
 101   3                  max_value2 = adc_value;
 102   3              }
 103   2          }
 104   1      
 105   1          adc_sum -= (uint32_t)min_value1 + min_value2 + max_value1 + max_value2;
 106   1      
 107   1          return (adc_sum * ADC_REFERENCE_MV * CURRENT_FIXED_POINT_SCALE) /
 108   1                 CURRENT_CONVERSION_DIVISOR;
 109   1      }
