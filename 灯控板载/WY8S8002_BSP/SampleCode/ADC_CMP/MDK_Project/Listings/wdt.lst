  57          void WDT_ClearWDT(void)
  58          {   
  59   1        if(GET_WDT_WDTCLR_STATUS() == WDT_WDTCLRED)
  60   1        {
  61   2          WDTCON &= ~WDT_WDTCON_WDTCLR;
  62   2        }
  63   1      }
  64          
  65          /**
