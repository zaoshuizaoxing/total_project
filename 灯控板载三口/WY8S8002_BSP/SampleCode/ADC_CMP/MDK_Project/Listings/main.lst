  70          static uint32_t ADC_ReadFilteredCurrentX10Ma(uint8_t channel)
  71          {
  72   1          uint8_t sample;
  73   1          uint16_t adc_value;
  74   1          uint16_t min_value1 = 0xFFFFU;
  75   1          uint16_t min_value2 = 0xFFFFU;
  76   1          uint16_t max_value1 = 0U;
  77   1          uint16_t max_value2 = 0U;
  78   1          uint32_t adc_sum = 0UL;
  79   1      
  80   1          ADC_ConfigChannel(channel, ADC_DIV_4);
  81   1          for(sample = 0U; sample < ADC_SAMPLE_COUNT; sample++)
  82   1          {
  83   2              ADC_StartSWCVT();
  84   2              adc_value = ADC_GetResultQueryMode();
  85   2              adc_sum += adc_value;
  86   2      
  87   2              if(adc_value < min_value1)
  88   2              {
  89   3                  min_value2 = min_value1;
  90   3                  min_value1 = adc_value;
  91   3              }
  92   2              else if(adc_value < min_value2)
  93   2              {
  94   3                  min_value2 = adc_value;
  95   3              }
  96   2      
  97   2              if(adc_value > max_value1)
  98   2              {
  99   3                  max_value2 = max_value1;
 100   3                  max_value1 = adc_value;
 101   3              }
 102   2              else if(adc_value > max_value2)
 103   2              {
 104   3                  max_value2 = adc_value;
 105   3              }
 106   2          }
 107   1      
 108   1          adc_sum -= (uint32_t)min_value1 + min_value2 + max_value1 + max_value2;
 109   1      
 110   1          return (adc_sum * ADC_REFERENCE_MV * CURRENT_FIXED_POINT_SCALE) /
 111   1                 CURRENT_CONVERSION_DIVISOR;
 112   1      }
