  44   1        for(i = 0; i < 8; i++)
  45   1        {
  46   2          WR_LOW();
  47   2          DATA_SET(cmd & 0x80);
  48   2          TM1622_NOP();
  49   2          WR_HIGH();
  50   2          cmd <<= 1;
